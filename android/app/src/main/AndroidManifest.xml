<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 媒体会话（K3 / CF-P3-KERNEL-004）：通知栏控制 + 蓝牙耳机键 + 后台播放。
         三条都缺一不可：
         · FOREGROUND_SERVICE         —— 前台服务本身（API 28+ 必需）
         · FOREGROUND_SERVICE_MEDIA_PLAYBACK —— **API 34+ 必需**的前台服务类型；
           缺失时 startForeground 直接抛 SecurityException（本 App targetSdk 36）
         · POST_NOTIFICATIONS         —— **API 33+ 必需**；不申请则通知栏控制
           根本不显示（而且不报错，只在 logcat 有一行，极难排查） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="CineFlow"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ══════ ★ OAuth 回调（自定义 Scheme）══════
                 用于接收 OAuth2 授权码（目前面向 Trakt；任何第三方登录/授权通用）。

                 ## Scheme 取值理由
                 `com.cineflow.app` 与 `applicationId` **完全一致** ⇒
                 天然唯一，不会被其它 App 抢占（`cineflow://` 这类通用词会撞车）。

                 ## 为什么挂在 MainActivity、而不是新建 OAuthCallbackActivity
                 本项目是 Flutter：Dart 侧用 `app_links` 接收 URI，
                 回调必须落到**承载 Flutter 引擎的 Activity**（即本 Activity）。
                 新建 Kotlin Activity 需手动把 URI 桥接回 Flutter，多一层出错点。
                 （Tivi 是原生 Kotlin，所以它能写独立 Activity —— 不可照搬。）

                 ## 为什么不需要改 launchMode
                 MainActivity 已是 `singleTop` ⇒ 浏览器授权后跳回**不会新开实例**，
                 而是复用现有实例触发 `onNewIntent` —— `app_links` 正是监听它。

                 ## ⚠️ debug/release 为什么只注册一个
                 `build.gradle.kts` 里**没有** `applicationIdSuffix`
                 ⇒ debug 与 release 包名相同 ⇒ 一个 scheme 即可。
                 （Tivi 注册两个是因为它的 debug 有 `app.tivi.debug` 后缀。） -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <!-- BROWSABLE 必需：授权页在**浏览器**里，要能唤起本 App -->
                <category android:name="android.intent.category.BROWSABLE"/>
                <!--
                  `com.cineflow.app://auth/oauth2callback`
                     scheme=com.cineflow.app  host=auth  path=/oauth2callback
                  OAuth 提供方的 Redirect URI 就填**这一整串**。
                -->
                <data
                    android:scheme="com.cineflow.app"
                    android:host="auth"
                    android:path="/oauth2callback"/>
            </intent-filter>
        </activity>
        <!-- 媒体会话服务（K3）：通知栏 / 蓝牙耳机键 / 后台播放。
             ⚠️ `foregroundServiceType="mediaPlayback"` 必须与 manifest 里的
                FOREGROUND_SERVICE_MEDIA_PLAYBACK 权限**成对**出现 ——
                只有权限没有类型、或有类型没权限，API 34+ 上都会崩。
             ⚠️ `exported="true"` 是**必需**的：系统（SystemUI / 蓝牙栈）
                要从外部绑定本服务来投递媒体键。 -->
        <service
            android:name=".player.CineFlowSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
